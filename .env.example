# Copy this file to .env and fill in what you have. Never share .env or paste keys into chats.

# Claude API key for the AI agents (News Hunter, Professor). Without it the bot runs in free math-only mode.
# Create one at https://console.anthropic.com -> API keys. Set a monthly spend limit there too (e.g. 20 USD).
ANTHROPIC_API_KEY=

# Bitpanda app API key: only for broker = "bitpanda" in config.toml (app quotes, ~1.5% spread).
# Give it Read + Trade permission. NEVER withdrawal permission.
BITPANDA_API_KEY=

# Bitpanda FUSION API key (recommended for live trading: about 0.25% fees instead of ~1.5%).
# Same Bitpanda account: open Bitpanda Fusion -> API keys. Read + Trade only, NEVER withdrawals.
BITPANDA_FUSION_API_KEY=

# Telegram phone briefing (optional, free). Create a bot with @BotFather, then send it any message and read your
# chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
